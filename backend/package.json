{
  "name": "dbis-backend",
  "version": "1.1.0",
  "description": "Backend for Decentralized Biometric Identity System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "setup": "node setup.js",
    "db:setup": "node setup-database.js",
    "db:migrate": "node setup-database.js",
    "blockchain:deploy:fuji": "npx hardhat run --network avalanche_fuji scripts/deploy-avalanche-proxy.js",
    "blockchain:verify:fuji": "npx hardhat verify --network avalanche_fuji",
    "setup:avax-testnet": "bash ../setup-avax-testnet.sh"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "argon2": "^0.43.0",
    "axios": ">=1.16.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "ethers": "^6.14.3",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.15.6",
    "qrcode": "^1.5.3",
    "speakeasy": "^2.0.0",
    "tough-cookie": "^5.1.2",
    "useragent": "^2.3.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomiclabs/hardhat-ethers": "^1.0.0",
    "@nomiclabs/hardhat-waffle": "^1.0.0",
    "@truffle/hdwallet-provider": "^2.0.16",
    "ganache": "^6.4.5",
    "hardhat": "^3.1.10",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "solc": "^0.8.29",
    "supertest": "^7.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
