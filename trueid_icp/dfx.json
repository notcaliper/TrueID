{
  "version": 1,
  "canisters": {
    "identity": {
      "type": "rust",
      "package": "identity",
      "candid": "src/identity/identity.did"
    },
    "professional": {
      "type": "rust",
      "package": "professional",
      "candid": "src/professional/professional.did"
    },
    "verification": {
      "type": "rust",
      "package": "verification",
      "candid": "src/verification/verification.did"
    },
    "storage": {
      "type": "rust",
      "package": "storage",
      "candid": "src/storage/storage.did"
    },
    "admin": {
      "type": "rust",
      "package": "admin",
      "candid": "src/admin/admin.did"
    },
    "frontend": {
      "type": "assets",
      "source": ["dist/"]
    }
  },
  "defaults": {
    "build": {
      "args": "",
      "packtool": ""
    }
  },
  "output_env_file": ".env",
  "networks": {
    "local": {
      "bind": "127.0.0.1:4943",
      "type": "ephemeral"
    },
    "ic": {
      "providers": ["https://icp0.io"],
      "type": "persistent"
    }
  }
}
